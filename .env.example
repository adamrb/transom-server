# ── Plaud developer credentials ─────────────────────────────────────────────
# Create a free "Embedded SDK Application" at https://portal.plaud.ai
PB_PLAUD_CLIENT_ID=
PB_PLAUD_SECRET_KEY=
# US: https://platform-us.plaud.ai/developer/api   JP: https://platform-jp.plaud.ai/developer/api
PB_PLAUD_API_BASE=https://platform-us.plaud.ai/developer/api

# ── Client auth ──────────────────────────────────────────────────────────────
# Bearer token(s) the Android app must present. Generate with: openssl rand -hex 32
# Comma-separate multiple tokens to allow rotation.
PB_AUTH_TOKENS=

# ── Transcription ────────────────────────────────────────────────────────────
PB_TRANSCRIBE_ENABLED=true
# "local"    = built-in faster-whisper (GPU/CPU, no external services, default)
# "parakeet" = built-in NVIDIA Parakeet via onnx-asr (GPU/CPU; no hallucinated
#              sentences, verbatim style, vocabulary hotwords don't apply)
# "openai"   = external OpenAI-compatible /v1/audio/transcriptions endpoint
PB_STT_ENGINE=local

# Built-in engine settings (PB_STT_ENGINE=local)
# Model: tiny/base/small/medium/large-v3/distil-large-v3/... or any CT2 repo id.
# Benchmark on your hardware: python -m app.benchmark audio.mp3 --models tiny,base,small
PB_STT_MODEL=base
PB_STT_DEVICE=auto            # auto | cuda | cpu
PB_STT_COMPUTE=auto           # auto | int8 | int8_float16 | float16 | float32
                              # (pre-Pascal GPUs support float32 only)
# PB_STT_VAD=true             # skip silence (recommended for long recordings)
# PB_STT_BEAM_SIZE=5
# PB_STT_CONDITION_ON_PREVIOUS=auto  # auto = on without custom vocabulary, off with it (on + hotwords drops speech and loops); or true/false
# PB_STT_MAX_DURATION_S=18000 # 5 h — matches Plaud hardware limits
# Noisy recordings (car, restaurant, wind): a recording whose loud/quiet frame
# spread is under PB_STT_ENHANCE_SPREAD_DB (quiet-room speech: 25–45 dB; a car
# recording: 8) gets a DeepFilterNet-cleaned copy; speech is located on the
# copy and the recognizer decodes those regions of the ORIGINAL audio, since
# its own VAD gate mistakes speech over noise for noise (see README).
# PB_STT_ENHANCE=auto         # auto | always | off
# PB_STT_ENHANCE_SPREAD_DB=15
# PB_STT_ENHANCE_BIN=         # path to the deep-filter binary (docker images bundle it in PATH)
# PB_STT_ENHANCE_DIARIZE=true # diarize on the cleaned copy too
# Consensus on noisy recordings (local engine): second opinions from Parakeet
# (CPU) and from whisper on a partially denoised copy, reconciled segment by
# segment by the cleanup LLM endpoint. Needs PB_CLEANUP_BASE_URL/MODEL (or the
# summary endpoint). See README "Consensus on noisy recordings".
# PB_STT_CONSENSUS=auto       # auto | off
# PB_STT_CONSENSUS_PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v2  # any onnx-asr model, or off
# PB_STT_CONSENSUS_ATTEN_DB=12  # noise reduction cap for the second whisper pass, or off
# PB_CONSENSUS_WINDOW_S=40    # seconds of audio per LLM call
# Speaker diarization (labels "Speaker 1/2/..."; needs the CUDA image or
# requirements-diarization.txt, plus a HF token accepted for the model below,
# default pyannote/speaker-diarization-community-1)
# PB_STT_DIARIZE=true
# PB_STT_HF_TOKEN=
# PB_STT_DIARIZE_MODEL=pyannote/speaker-diarization-community-1
# PB_STT_DIARIZE_DEVICE=      # auto | cuda | cpu; unset = same as PB_STT_DEVICE. cpu keeps
#                             # the GPU for the recognizer on small or shared cards
# Speaker-count hints (unset = automatic; auto under-counts on short clips or
# similar voices). NUM is exact and overrides MIN/MAX.
# PB_STT_NUM_SPEAKERS=
# PB_STT_MIN_SPEAKERS=
# PB_STT_MAX_SPEAKERS=

# Parakeet engine settings (PB_STT_ENGINE=parakeet; PB_STT_DEVICE, the
# diarization and duration settings above apply too)
# PB_STT_PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3  # 25 European languages; -v2 = English only
# PB_STT_PARAKEET_QUANT=       # int8 for the quantized weights (mostly a CPU speed-up)
# PB_STT_PARAKEET_SEGMENT_S=30 # longest VAD chunk decoded at once (more context for punctuation)
# PB_STT_PARAKEET_SILENCE_MS=600  # pause that ends a chunk
# Benchmark: python -m app.benchmark audio.mp3 --engine parakeet [--models nemo-parakeet-tdt-0.6b-v3,nemo-parakeet-tdt-0.6b-v2]

# LLM cleanup pass (any engine): fixes misheard names/terms/acronyms/numbers with
# the custom vocabulary as a glossary, drops fillers. Uses the PB_SUMMARY_* endpoint
# unless overridden. One call per PB_CLEANUP_MAX_CHARS of transcript.
# PB_CLEANUP_ENABLED=true
# PB_CLEANUP_CONTEXT=The speaker works in cloud infrastructure; recordings are work meetings and personal voice memos.
# PB_CLEANUP_FILLERS=true      # remove uh/um, stutters, false starts
# PB_CLEANUP_MAX_CHARS=30000
# PB_CLEANUP_TIMEOUT_S=300
# PB_CLEANUP_BASE_URL=         # defaults to PB_SUMMARY_BASE_URL
# PB_CLEANUP_MODEL=            # defaults to PB_SUMMARY_MODEL
# PB_CLEANUP_API_KEY=          # defaults to PB_SUMMARY_API_KEY

# External engine settings (PB_STT_ENGINE=openai)
# PB_TRANSCRIBE_BASE_URL=      # include the /v1 suffix
# PB_TRANSCRIBE_API_KEY=
# PB_TRANSCRIBE_MODEL=whisper-1
# PB_TRANSCRIBE_TIMEOUT_S=1800

# PB_TRANSCRIBE_LANGUAGE=en    # force a language (local + openai engines; parakeet detects it itself)
# PB_TRANSCRIBE_MAX_ATTEMPTS=3

# ── Summaries (optional, any OpenAI-compatible chat endpoint) ────────────────
# Generates an AI summary of each transcript (title + summary + action items).
# PB_SUMMARY_ENABLED=true
# PB_SUMMARY_BASE_URL=
# PB_SUMMARY_API_KEY=
# PB_SUMMARY_MODEL=
# PB_SUMMARY_PROMPT=            # override the default summarization prompt
# PB_SUMMARY_MAX_CHARS=60000

# ── AI routing (optional) ────────────────────────────────────────────────────
# After transcription, an LLM decides which of your configured routes
# (managed via the /api/v1/routes API) apply to each recording and runs
# their actions (webhook / markdown note / decision-only). The chat endpoint
# settings fall back to PB_SUMMARY_* when unset, so one LLM can serve both.
# PB_ROUTER_ENABLED=true
# PB_ROUTER_BASE_URL=           # OpenAI-compatible, include the /v1 suffix
# PB_ROUTER_API_KEY=
# PB_ROUTER_MODEL=
# PB_ROUTER_MAX_CHARS=4000      # transcript excerpt size sent to the router

# ── Downstream hooks (optional) ──────────────────────────────────────────────
# POSTed a JSON payload after each successful transcription.
# PB_WEBHOOK_URL=
# PB_WEBHOOK_AUTH_HEADER=Authorization: Bearer changeme

# Write a markdown note per transcript (e.g. into an Obsidian vault mount).
# PB_MARKDOWN_EXPORT_DIR=/notes

# ── Storage ──────────────────────────────────────────────────────────────────
# PB_DATA_DIR=/data
# PB_MAX_UPLOAD_MB=500

# ── Android app distribution ─────────────────────────────────────────────────
# The server can host the Plaud Bridge APK for phones (upload via the
# dashboard's "Connect a phone" modal or POST /api/v1/apk).
# PB_APK_MAX_UPLOAD_MB=300
# Release docker images bake the matching APK + manifest.json into this
# directory; at startup it is auto-published if newer than the hosted one.
# PB_BUNDLED_APK_DIR=/srv/plaud-bridge/bundled-apk

# Reverse proxy addresses (IPs/CIDRs) whose X-Forwarded-For is trusted for
# per-client rate limits on the public QR sign-in endpoint. Empty = trust none.
# PB_TRUSTED_PROXIES=172.18.0.2
