# GPU image: built-in faster-whisper on CUDA + pyannote speaker diarization.
#
# The PyPI CTranslate2 wheels ship CUDA kernels for compute capability >= 6.1
# (Pascal+). For older cards (e.g. Maxwell / GTX 900 series, sm_52) build your
# own CTranslate2 wheel with CT2_CUDA_ARCH_LIST set to your card's compute
# capability and drop it into wheels-local/ — it will be installed over the
# PyPI wheel automatically.

# Stage 1: build the web dashboard (same as Dockerfile).
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# Stage 2: the CUDA server image.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

# libopenblas: custom-built CTranslate2 wheels link the system BLAS rather
# than bundling one (the PyPI wheel ships its own); harmless when unused.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3-pip libopenblas0-pthread libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Drop the CUDA forward-compatibility driver the base image ships. When the
# host driver is older than the container's CUDA version, the container
# toolkit points libcuda.so.1 at these compat libs — but CUDA forward compat
# only works on datacenter GPUs; on GeForce every call fails with
# "CUDA error 804: forward compatibility was attempted on non supported HW".
# Removing it binds the host driver and relies on CUDA minor-version
# compatibility, which consumer cards support.
RUN apt-get remove -y --purge cuda-compat-12-6 2>/dev/null; \
    rm -rf /usr/local/cuda-12.6/compat /usr/local/cuda/compat && ldconfig

WORKDIR /srv/plaud-bridge

RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

COPY requirements.txt requirements-stt.txt requirements-diarization.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-stt.txt \
    -r requirements-diarization.txt

# Parakeet on the GPU: replace the CPU-only onnxruntime (a faster-whisper
# dependency, same import name) with the CUDA build. onnxruntime-gpu 1.27+ is
# built against CUDA 13, which dropped Maxwell/Pascal and needs a 580+ driver;
# 1.21–1.26 are CUDA 12.8 builds that run on this image's CUDA 12.6 stack.
# The != exclusions mirror onnx-asr's own [gpu] extra (releases it knows to
# be broken with its models); keep them in step with that package.
# At runtime the engine preloads the cuDNN 9.10 / cuBLAS 12.6 wheels torch
# installed above (ort.preload_dlls) instead of the system copies. Note the
# PyPI onnxruntime-gpu kernels start at Pascal (sm_60): on a Maxwell card
# (GTX 900 series) the engine detects cudaErrorNoKernelImageForDevice on its
# warm-up pass and runs Parakeet on the CPU, leaving the GPU to pyannote.
RUN pip uninstall -y onnxruntime && \
    pip install --no-cache-dir "onnxruntime-gpu>=1.21,<1.27,!=1.24.1,!=1.25.*,!=1.26.0"

# Optional custom wheels (e.g. CTranslate2 built for pre-Pascal GPUs)
COPY wheels-local/ /tmp/wheels-local/
RUN if ls /tmp/wheels-local/*.whl >/dev/null 2>&1; then \
        pip install --no-cache-dir --force-reinstall --no-deps /tmp/wheels-local/*.whl; \
    fi && rm -rf /tmp/wheels-local

# DeepFilterNet 3 standalone binary (static, CPU): denoises a copy of noisy
# recordings so the speech can be located when the raw noise floor hides it
# from the VAD (see app/engines/enhance.py). Pinned release + checksum.
ARG DEEP_FILTER_URL=https://github.com/Rikorose/DeepFilterNet/releases/download/v0.5.6/deep-filter-0.5.6-x86_64-unknown-linux-musl
ARG DEEP_FILTER_SHA256=70775e251eee44c0f2451a1e833326cf8bcbbe304d3e7cd12851e6fce72ef7da
RUN python3 -c "import hashlib, sys, urllib.request; \
    data = urllib.request.urlopen('${DEEP_FILTER_URL}').read(); \
    assert hashlib.sha256(data).hexdigest() == '${DEEP_FILTER_SHA256}', 'deep-filter checksum mismatch'; \
    open('/usr/local/bin/deep-filter', 'wb').write(data)" \
    && chmod 0755 /usr/local/bin/deep-filter

COPY app ./app
COPY --from=web /app/static ./app/static
# Optional: drop a built APK + manifest.json here (or bake via CI) and a fresh
# server auto-hosts it for the Android app's self-update check.
COPY bundled-apk/ ./bundled-apk/

# ubuntu24.04 bases already ship a uid-1000 user; reuse it if present.
RUN id -u 1000 >/dev/null 2>&1 || useradd -u 1000 -m appuser; \
    mkdir -p /data && chown 1000 /data
USER 1000

# Keep downloaded models inside the data volume so they survive rebuilds.
ENV PB_DATA_DIR=/data \
    HF_HOME=/data/models
VOLUME /data
EXPOSE 8090

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8090"]
