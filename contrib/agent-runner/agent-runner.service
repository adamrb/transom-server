# systemd user unit template for agent-runner.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp agent-runner.service ~/.config/systemd/user/
#   # edit the paths below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now agent-runner
#   loginctl enable-linger $USER   # keep it running when logged out

[Unit]
Description=plaud-bridge agent runner (webhook -> commands)
After=network.target docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /path/to/agent-runner/agent_runner.py --config /path/to/agent-runner/config.toml
# ACP agents are child processes; make sure node/claude-code-acp (e.g. an
# nvm bin dir) and any CLIs in ~/.local/bin are on PATH:
#Environment=PATH=%h/.nvm/versions/node/v22.0.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Binding to a Docker bridge gateway IP fails until that network exists;
# keep retrying.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
